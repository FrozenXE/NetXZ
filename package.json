{
  "name": "netxz",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "vite --host",
    "build:android": "npm run build && npx cap copy android && npx cap sync android",
    "watch:android": "concurrently \"npm run start\" \"npm run watch:build\"",
    "watch:build": "chokidar 'src/**/*' -c './build-android.bat'"
  },
